{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/arch.txt",
         "color": {
                    "1": "blue"
            },
        "padding": {
	        "top": 1
	    }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
	"break",
    "break",
	"title",
        {
            "type": "os",
            "key": "os    ",
            "keyColor": "37"
        },
        {
            "type": "kernel",
            "key": "kernel",
            "keyColor": "31"
        },
        {
            "type": "host",
            "format": "{5} {1}",
            "key": "host  ",
            "keyColor": "35"
        },
        {
            "type": "disk",
            "key": "Disk ",
            "keyColor": "34"  
        },
        {
            "type": "cpu",
            "format": "{2}",
            "key": "cpu",
            "keyColor": "32"
        },
        {
            "type": "memory",
            "key": "memory",
            "keyColor": "33"
         },
        {
            "type": "gpu",
            "format": "{1} {2}",
             "key": "gpu",
            "keyColor": "36"
        },
        "break",
        "break"
    ]
}
